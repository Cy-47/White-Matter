include README.md LICENSE NOTICE
recursive-include LICENSES *.txt
recursive-include docs *.md
recursive-include examples *.py
recursive-include benchmarks *.py *.md
recursive-include training *.py
recursive-include evals *.py
recursive-include scripts *.py
recursive-include recipes *.yaml
recursive-include slurm *.sbatch *.md
recursive-include studies *.py *.yaml *.sbatch *.md
recursive-include tests *.py
prune outputs
prune data
prune artifacts
prune checkpoints
prune logs
include slurm_logs/.gitkeep
prune .venv
prune .git
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
global-exclude *.py[cod] *.log *.out *.err *.pt *.pth *.safetensors *.npy *.npz .env .env.*
